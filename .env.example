# API Keys (at least one is required)
OPENAI_API_KEY=your_openai_api_key
MISTRAL_API_KEY=your_mistral_api_key

# Environment
PYTHON_ENV=development
YOLO_VERBOSE=False

# Model settings
YOLO_MODEL_PATH=yolo11n.pt
OPENAI_MODEL=gpt-4o
MISTRAL_MODEL=pixtral-12b-2409

# Server settings
HOST=127.0.0.1
PORT=8000

# SRS settings
SRS_HOST=srs
